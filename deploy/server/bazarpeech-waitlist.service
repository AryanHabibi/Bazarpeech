[Unit]
Description=BazarPeech waitlist endpoint
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/bazarpeech/waitlist.py
EnvironmentFile=/etc/bazarpeech/waitlist.env
DynamicUser=yes
StateDirectory=bazarpeech
Restart=on-failure
RestartSec=2

# the service only needs to talk out to Telegram and write its own state
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
